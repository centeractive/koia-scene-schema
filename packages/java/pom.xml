<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
   <modelVersion>4.0.0</modelVersion>

   <groupId>com.centeractive.koia</groupId>
   <artifactId>koia-scene-model</artifactId>
   <version>${revision}</version>
   <packaging>bundle</packaging>

   <name>Koia scene model</name>
   <description>Java classes generated from the Koia scene JSON Schema, for programs that write scenes into CouchDB for Koia</description>
   <url>https://github.com/centeractive/koia-scene-schema</url>

   <licenses>
      <license>
         <name>MIT License</name>
         <url>https://opensource.org/licenses/MIT</url>
      </license>
   </licenses>

   <developers>
      <developer>
         <name>centeractive ag</name>
         <email>info@centeractive.com</email>
         <organization>centeractive ag</organization>
         <organizationUrl>https://www.centeractive.com</organizationUrl>
      </developer>
   </developers>

   <scm>
      <connection>scm:git:https://github.com/centeractive/koia-scene-schema.git</connection>
      <developerConnection>scm:git:ssh://git@github.com/centeractive/koia-scene-schema.git</developerConnection>
      <url>https://github.com/centeractive/koia-scene-schema</url>
   </scm>

   <properties>
      <revision>0.0.0-SNAPSHOT</revision>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <maven.compiler.release>21</maven.compiler.release>
      <schemas.dir>${project.basedir}/../../schemas</schemas.dir>
      <examples.dir>${project.basedir}/../../examples</examples.dir>
      <gson.version>2.13.2</gson.version>
      <junit.version>6.1.3</junit.version>
      <json-schema-validator.version>3.0.8</json-schema-validator.version>
   </properties>

   <dependencies>
      <dependency>
         <groupId>com.google.code.gson</groupId>
         <artifactId>gson</artifactId>
         <version>${gson.version}</version>
         <scope>provided</scope>
      </dependency>
      <dependency>
         <groupId>org.junit.jupiter</groupId>
         <artifactId>junit-jupiter</artifactId>
         <version>${junit.version}</version>
         <scope>test</scope>
      </dependency>
      <dependency>
         <groupId>com.networknt</groupId>
         <artifactId>json-schema-validator</artifactId>
         <version>${json-schema-validator.version}</version>
         <scope>test</scope>
      </dependency>
   </dependencies>

   <build>
      <resources>
         <resource>
            <directory>${schemas.dir}</directory>
            <targetPath>koia-scene-schema</targetPath>
         </resource>
      </resources>
      <plugins>
         <plugin>
            <groupId>org.jsonschema2pojo</groupId>
            <artifactId>jsonschema2pojo-maven-plugin</artifactId>
            <version>1.3.3</version>
            <configuration>
               <sourcePaths>
                  <sourcePath>${schemas.dir}/1.0/scene.schema.json</sourcePath>
               </sourcePaths>
               <sourceType>jsonschema</sourceType>
               <targetPackage>com.centeractive.koia.scene.v1</targetPackage>
               <annotationStyle>gson</annotationStyle>
               <useLongIntegers>true</useLongIntegers>
               <useTitleAsClassname>true</useTitleAsClassname>
               <generateBuilders>true</generateBuilders>
               <includeAdditionalProperties>false</includeAdditionalProperties>
               <includeJsr303Annotations>false</includeJsr303Annotations>
            </configuration>
            <executions>
               <execution>
                  <goals>
                     <goal>generate</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
         <plugin>
            <groupId>org.apache.felix</groupId>
            <artifactId>maven-bundle-plugin</artifactId>
            <version>6.2.0</version>
            <extensions>true</extensions>
            <configuration>
               <instructions>
                  <Bundle-SymbolicName>com.centeractive.koia.scene.model</Bundle-SymbolicName>
                  <Export-Package>com.centeractive.koia.scene.v1</Export-Package>
               </instructions>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-surefire-plugin</artifactId>
            <version>3.6.0</version>
            <configuration>
               <systemPropertyVariables>
                  <examples.dir>${examples.dir}</examples.dir>
               </systemPropertyVariables>
            </configuration>
         </plugin>
         <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>flatten-maven-plugin</artifactId>
            <version>1.8.0</version>
            <configuration>
               <flattenMode>ossrh</flattenMode>
               <updatePomFile>true</updatePomFile>
            </configuration>
            <executions>
               <execution>
                  <id>flatten</id>
                  <phase>process-resources</phase>
                  <goals>
                     <goal>flatten</goal>
                  </goals>
               </execution>
               <execution>
                  <id>flatten-clean</id>
                  <phase>clean</phase>
                  <goals>
                     <goal>clean</goal>
                  </goals>
               </execution>
            </executions>
         </plugin>
      </plugins>
   </build>

   <profiles>
      <profile>
         <id>release</id>
         <build>
            <plugins>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-source-plugin</artifactId>
                  <version>3.3.1</version>
                  <executions>
                     <execution>
                        <goals>
                           <goal>jar-no-fork</goal>
                        </goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-javadoc-plugin</artifactId>
                  <version>3.12.0</version>
                  <executions>
                     <execution>
                        <goals>
                           <goal>jar</goal>
                        </goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.apache.maven.plugins</groupId>
                  <artifactId>maven-gpg-plugin</artifactId>
                  <version>3.2.8</version>
                  <executions>
                     <execution>
                        <phase>verify</phase>
                        <goals>
                           <goal>sign</goal>
                        </goals>
                     </execution>
                  </executions>
               </plugin>
               <plugin>
                  <groupId>org.sonatype.central</groupId>
                  <artifactId>central-publishing-maven-plugin</artifactId>
                  <version>0.12.0</version>
                  <extensions>true</extensions>
                  <configuration>
                     <publishingServerId>central</publishingServerId>
                     <autoPublish>true</autoPublish>
                  </configuration>
               </plugin>
            </plugins>
         </build>
      </profile>
   </profiles>
</project>
